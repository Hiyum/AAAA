//@version=5
// =============================================================
//  ClaudeAI High Win-Rate Mean Reversion (Connors RSI-2 기반)
// =============================================================
//  근거: Larry Connors RSI-2 전략 (Street Smarts / Short Term
//  Trading Strategies That Work). 문서화된 백테스트 승률 70~85%.
//
//  원리 (고승률의 수학):
//   - 장기 추세 방향(EMA200)에서만 거래
//   - RSI(2) < 5 극단 과매도 → 매수 / RSI(2) > 95 → 매도
//   - 청산: RSI(2)가 50 복귀 시 (작은 이익 빠르게 확보)
//   - 손절은 넓게(ATR×3), 목표는 작게(ATR×1)
//   ⇒ 승률은 높아지지만, 질 때는 크게 짐.
//   ⇒ 손익분기 승률 = 3/(3+1) = 75%. 실측 80%+면 흑자.
//
//  대상: 외환 (AUDUSD 등) / 권장: 15분봉
//  당일 청산: 세션 종료 시 전량 청산 (오버나이트 금지)
//
//  [붙여넣기 전] Pine Editor 전부 삭제(Ctrl+A→Delete) 후 붙여넣기
// =============================================================
strategy("ClaudeAI MeanReversion RSI2", overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0.0,
     slippage=1)

// ── 입력 파라미터 ──────────────────────────────────────
symbolName  = input.string("AUDUSD", "MT5 종목명 (브로커 기준)")
emaTrendLen = input.int(200, "장기 추세 EMA")
rsiBuyLvl   = input.float(10.0, "매수 진입 RSI(2) 이하", minval=1, maxval=20)
rsiSellLvl  = input.float(90.0, "매도 진입 RSI(2) 이상", minval=80, maxval=99)
rsiExitLvl  = input.float(50.0, "청산 RSI(2) 기준 (중립 복귀)")
useBB       = input.bool(false, "볼린저밴드 확인 추가 (거래 줄지만 정확도 ↑)")
bbLen       = input.int(20, "볼린저 기간")
bbMult      = input.float(2.0, "볼린저 배수")
adxLen      = input.int(14, "ADX 기간")
adxMax      = input.float(40.0, "최대 ADX (폭주 추세 회피)")
atrLen      = input.int(14, "ATR 기간")
slMult      = input.float(3.0, "손절 = ATR × (넓게)")
tpMult      = input.float(1.0, "목표 = ATR × (작게)")
tradeSession = input.session("0700-2000", "거래 세션 (런던+뉴욕)")
sessionTZ    = input.string("GMT", "세션 시간대")

// ── 지표 계산 ──────────────────────────────────────────
emaTrend = ta.ema(close, emaTrendLen)
rsi2     = ta.rsi(close, 2)
rsi14    = ta.rsi(close, 14)
atrVal   = ta.atr(atrLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

bbBasis = ta.sma(close, bbLen)
bbDev   = bbMult * ta.stdev(close, bbLen)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

inSession = not na(time(timeframe.period, tradeSession, sessionTZ))
calmMarket = adxVal <= adxMax   // 폭주 추세(역행 위험)가 아닐 때만

// ── 진입 조건 (Connors 스타일 평균회귀) ─────────────────
// 매수: 장기 상승추세 + RSI(2) 극단 과매도 (+옵션: 볼린저 하단 이탈)
longSignal  = inSession and calmMarket and close > emaTrend and rsi2 < rsiBuyLvl  and (not useBB or close < bbLower)
// 매도: 장기 하락추세 + RSI(2) 극단 과매수 (+옵션: 볼린저 상단 이탈)
shortSignal = inSession and calmMarket and close < emaTrend and rsi2 > rsiSellLvl and (not useBB or close > bbUpper)

longSL  = close - atrVal * slMult
longTP  = close + atrVal * tpMult
shortSL = close + atrVal * slMult
shortTP = close - atrVal * tpMult

// ── 청산 조건: RSI(2) 중립 복귀 (고승률의 핵심) ─────────
exitLong  = ta.crossover(rsi2, rsiExitLvl)    // 롱: RSI2가 50 위로 회복
exitShort = ta.crossunder(rsi2, rsiExitLvl)   // 숏: RSI2가 50 아래로 하락

// ── 백테스트 매매 ───────────────────────────────────────
if longSignal and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)
    strategy.exit("Long X", "Long", stop=longSL, limit=longTP)

if shortSignal and strategy.position_size >= 0
    strategy.entry("Short", strategy.short)
    strategy.exit("Short X", "Short", stop=shortSL, limit=shortTP)

// RSI 중립 복귀 시 조기 청산 (작은 이익 확보 → 승률 상승)
if strategy.position_size > 0 and exitLong
    strategy.close("Long", comment="RSI복귀")
if strategy.position_size < 0 and exitShort
    strategy.close("Short", comment="RSI복귀")

// 세션 종료 시 전량 청산 (당일 청산 원칙)
sessionEnded = inSession[1] and not inSession
if sessionEnded
    strategy.close_all(comment="당일청산")

// ── Webhook JSON (실거래용) ─────────────────────────────
sigAction = sessionEnded ? "CLOSE_ALL" : longSignal ? "BUY" : shortSignal ? "SELL" : "HOLD"
sl_ = sigAction == "SELL" ? shortSL : longSL
tp_ = sigAction == "SELL" ? shortTP : longTP
trendStr = close > emaTrend ? "bullish" : "bearish"

buildJson(action, slv, tpv) =>
    '{"symbol": "' + symbolName + '"' +
      ', "action": "' + action + '"' +
      ', "price": ' + str.tostring(close, "#.#####") +
      ', "market_structure": "' + trendStr + '"' +
      ', "rsi2": ' + str.tostring(rsi2, "#.#") +
      ', "rsi": ' + str.tostring(rsi14, "#.#") +
      ', "adx": ' + str.tostring(adxVal, "#.#") +
      ', "bb_lower": ' + str.tostring(bbLower, "#.#####") +
      ', "bb_upper": ' + str.tostring(bbUpper, "#.#####") +
      ', "atr": ' + str.tostring(atrVal, "#.#####") +
      ', "in_session": ' + (inSession ? "true" : "false") +
      ', "exit_long": ' + (exitLong ? "true" : "false") +
      ', "exit_short": ' + (exitShort ? "true" : "false") +
      ', "sl": ' + str.tostring(slv, "#.#####") +
      ', "tp": ' + str.tostring(tpv, "#.#####") +
      ', "timeframe": "' + timeframe.period + '"}'

alert(buildJson(sigAction, sl_, tp_), alert.freq_once_per_bar_close)

// ── 차트 시각화 ─────────────────────────────────────────
plot(emaTrend, "EMA200", color.red, 2)
plot(bbUpper, "BB 상단", color.new(color.blue, 60))
plot(bbLower, "BB 하단", color.new(color.blue, 60))
bgcolor(inSession ? na : color.new(color.gray, 92))
plotshape(longSignal,  "LONG",  shape.triangleup,   location.belowbar, color.green, size=size.small)
plotshape(shortSignal, "SHORT", shape.triangledown, location.abovebar, color.red,   size=size.small)
