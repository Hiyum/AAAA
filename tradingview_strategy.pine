//@version=5
// =============================================================
//  ClaudeAI GOLD ORB v5.5 — 멀티 셋업 (문턱 유지, 문 3개)
// =============================================================
//  대상: GOLD (XAUUSD) / 15분봉
//
//  ── 설계 원리: 빈도를 올리는 유일하게 안전한 방법 ────────
//  조건 완화(v6~v8)는 전부 실패했다 (거래↑ = 성적↓ 실증).
//  대신 '똑같이 엄격한' 독립 셋업을 추가한다:
//   A) 아시안 레인지 돌파 (기존 - 3개월 실측 PF 1.909, WR 70%)
//   B) NY 오픈 전 레인지(12:00-13:30) 돌파 - 뉴욕 세션 확장
//   C) 전일 고점/저점(PDH/PDL) 돌파 - 데일리 레벨 확장
//  각 셋업 방향별 하루 1회, 전부 동일한 검증된 청산 엔진.
//  예상 빈도: 하루 1~2.5회 (기존의 ~2.5배)
//
//  ⚠ 검증 필수: 같은 기간으로 백테스트해서 기준선(PF 1.909)과 비교.
//    B/C는 개별 ON/OFF 가능 - 나쁜 셋업만 끄면 된다.
//
//  청산: 1R 부분익절 50% + 본전 잠금 → 2×ATR 트레일링
//        20:00 GMT 전량 청산 (오버나이트 금지)
//  [붙여넣기 전] Pine Editor 전부 삭제(Ctrl+A→Delete)
// =============================================================
strategy("ClaudeAI GOLD ORB v55", overlay=true,
     initial_capital=100,
     default_qty_type=strategy.cash, default_qty_value=1500,
     commission_type=strategy.commission.percent, commission_value=0.01,
     slippage=2, process_orders_on_close=true)

// ── 입력 ────────────────────────────────────────────────
symbolName  = input.string("GOLD#", "MT5 종목명 (브로커 표기)")
asianSess   = input.session("0000-0700", "A: 아시안 레인지 (GMT)")
tradeSess   = input.session("0700-1700", "A: 돌파 허용 시간 (GMT)")
useNyOrb    = input.bool(true, "B: NY 오픈 전 레인지 돌파 사용")
nyRangeSess = input.session("1200-1330", "B: NY 레인지 (GMT)")
nyTradeSess = input.session("1330-1700", "B: 돌파 허용 시간 (GMT)")
usePdhl     = input.bool(true, "C: 전일 고점/저점 돌파 사용")
flattenSess = input.session("0700-2000", "보유 허용 - 끝나면 전량 청산 (GMT)")
sessionTZ   = input.string("GMT", "시간대")
trendAlign  = input.bool(true, "EMA200 방향 일치 필수 (전 셋업 공통)")
bufMult     = input.float(0.10, "돌파 확정 버퍼 = ATR ×", step=0.05)
minRangeAtr = input.float(0.8, "최소 레인지 = ATR ×", step=0.1)
maxRangeAtr = input.float(4.0, "최대 레인지 = ATR ×", step=0.5)
atrLen      = input.int(14, "ATR 기간")
slCapAtr    = input.float(2.5, "손절 최대 캡 = ATR ×", step=0.25)
tp1R        = input.float(1.0, "부분익절(50%) = R ×", step=0.25)
trailAtr    = input.float(2.0, "트레일링 = ATR ×", step=0.25)

// ── 지표 ────────────────────────────────────────────────
atrVal   = ta.atr(atrLen)
emaTrend = ta.ema(close, 200)
rsi14    = ta.rsi(close, 14)

inAsian   = not na(time(timeframe.period, asianSess, sessionTZ))
inWindowA = not na(time(timeframe.period, tradeSess, sessionTZ))
inNyRange = not na(time(timeframe.period, nyRangeSess, sessionTZ))
inWindowN = not na(time(timeframe.period, nyTradeSess, sessionTZ))
holdTime  = time(timeframe.period, flattenSess, sessionTZ)
inHold    = not na(holdTime)

// 전일 고점/저점 (셋업 C)
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_off)

// ── 레인지 집계 (매일 리셋) ─────────────────────────────
isNewDay = ta.change(time("D")) != 0
var float aHi = na
var float aLo = na
var float nHi = na
var float nLo = na
var bool tookLongA = false
var bool tookShortA = false
var bool tookLongN = false
var bool tookShortN = false
var bool tookLongP = false
var bool tookShortP = false

if isNewDay
    aHi := na
    aLo := na
    nHi := na
    nLo := na
    tookLongA := false
    tookShortA := false
    tookLongN := false
    tookShortN := false
    tookLongP := false
    tookShortP := false

if inAsian
    aHi := na(aHi) ? high : math.max(aHi, high)
    aLo := na(aLo) ? low : math.min(aLo, low)
if inNyRange
    nHi := na(nHi) ? high : math.max(nHi, high)
    nLo := na(nLo) ? low : math.min(nLo, low)

rangeWA = not na(aHi) and not na(aLo) ? aHi - aLo : na
rangeOKA = not na(rangeWA) and rangeWA >= atrVal * minRangeAtr and rangeWA <= atrVal * maxRangeAtr
rangeWN = not na(nHi) and not na(nLo) ? nHi - nLo : na
rangeOKN = not na(rangeWN) and rangeWN >= atrVal * 0.4 and rangeWN <= atrVal * maxRangeAtr

// ── 진입 조건 (셋업 3종, 문턱 동일) ─────────────────────
buf = atrVal * bufMult
alignL = not trendAlign or close > emaTrend
alignS = not trendAlign or close < emaTrend

// A: 아시안 ORB (기존 그대로)
longA  = inWindowA and not inAsian and rangeOKA and not tookLongA  and alignL and close > aHi + buf and close[1] <= aHi + buf
shortA = inWindowA and not inAsian and rangeOKA and not tookShortA and alignS and close < aLo - buf and close[1] >= aLo - buf

// B: NY 오픈 전 레인지 돌파
longN  = useNyOrb and inWindowN and not inNyRange and rangeOKN and not tookLongN  and alignL and close > nHi + buf and close[1] <= nHi + buf
shortN = useNyOrb and inWindowN and not inNyRange and rangeOKN and not tookShortN and alignS and close < nLo - buf and close[1] >= nLo - buf

// C: 전일 고점/저점 돌파 (아시안 시간 제외)
longP  = usePdhl and inWindowA and not inAsian and not na(pdh) and not tookLongP  and alignL and close > pdh + buf and close[1] <= pdh + buf
shortP = usePdhl and inWindowA and not inAsian and not na(pdl) and not tookShortP and alignS and close < pdl - buf and close[1] >= pdl - buf

longSignal  = longA or longN or longP
shortSignal = shortA or shortN or shortP
setupStr = longA or shortA ? "ASIA_ORB" : longN or shortN ? "NY_ORB" : "PDHL"

// 손절: 셋업별 레벨 반대편, 최대 slCapAtr×ATR 캡
longLvl  = longA ? aLo : longN ? nLo : pdl
shortLvl = shortA ? aHi : shortN ? nHi : pdh
longSL  = math.max(na(longLvl) ? close - atrVal * slCapAtr : longLvl,  close - atrVal * slCapAtr)
shortSL = math.min(na(shortLvl) ? close + atrVal * slCapAtr : shortLvl, close + atrVal * slCapAtr)

// ── 포지션 상태 ─────────────────────────────────────────
var float stopLvl = na
var float riskAmt = na
var bool tookPartial = false

if strategy.position_size == 0
    tookPartial := false

entryPrice = strategy.opentrades > 0 ? strategy.opentrades.entry_price(strategy.opentrades - 1) : na

// ── 진입 ────────────────────────────────────────────────
if longSignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    stopLvl := longSL
    riskAmt := close - longSL
    if longA
        tookLongA := true
    if longN
        tookLongN := true
    if longP
        tookLongP := true

if shortSignal and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    stopLvl := shortSL
    riskAmt := shortSL - close
    if shortA
        tookShortA := true
    if shortN
        tookShortN := true
    if shortP
        tookShortP := true

// ── 청산 스택 (검증된 엔진 그대로) ──────────────────────
if strategy.position_size > 0 and not na(entryPrice) and not na(riskAmt)
    tp1 = entryPrice + riskAmt * tp1R
    if not tookPartial and high >= tp1
        strategy.close("Long", qty_percent=50, comment="TP1")
        tookPartial := true
        stopLvl := math.max(stopLvl, entryPrice)
    if tookPartial
        stopLvl := math.max(stopLvl, close - atrVal * trailAtr)
    strategy.exit("L-X", "Long", stop=stopLvl)

if strategy.position_size < 0 and not na(entryPrice) and not na(riskAmt)
    tp1s = entryPrice - riskAmt * tp1R
    if not tookPartial and low <= tp1s
        strategy.close("Short", qty_percent=50, comment="TP1")
        tookPartial := true
        stopLvl := math.min(stopLvl, entryPrice)
    if tookPartial
        stopLvl := math.min(stopLvl, close + atrVal * trailAtr)
    strategy.exit("S-X", "Short", stop=stopLvl)

// 보유 시간 종료: 전량 청산
holdEnded = not na(holdTime[1]) and na(holdTime)
if holdEnded
    strategy.close_all(comment="당일청산")

// ── Webhook JSON ────────────────────────────────────────
sigAction = holdEnded ? "CLOSE_ALL" : longSignal ? "BUY" : shortSignal ? "SELL" : "HOLD"
sl_ = sigAction == "SELL" ? shortSL : longSL
riskNow = sigAction == "SELL" ? (shortSL - close) : (close - longSL)
tp_ = sigAction == "SELL" ? close - riskNow * 2 : close + riskNow * 2
trendStr = close > emaTrend ? "bullish" : "bearish"

buildJson(action, slv, tpv) =>
    '{"symbol": "' + symbolName + '"' +
      ', "action": "' + action + '"' +
      ', "mode": "GOLD_ORB"' +
      ', "setup": "' + setupStr + '"' +
      ', "price": ' + str.tostring(close, format.mintick) +
      ', "market_structure": "' + trendStr + '"' +
      ', "asian_high": ' + str.tostring(na(aHi) ? close : aHi, format.mintick) +
      ', "asian_low": ' + str.tostring(na(aLo) ? close : aLo, format.mintick) +
      ', "range_atr_ratio": ' + str.tostring(na(rangeWA) ? 0 : rangeWA / atrVal, "#.##") +
      ', "rsi": ' + str.tostring(rsi14, "#.#") +
      ', "atr": ' + str.tostring(atrVal, format.mintick) +
      ', "in_session": ' + (inWindowA ? "true" : "false") +
      ', "sl": ' + str.tostring(slv, format.mintick) +
      ', "tp": ' + str.tostring(tpv, format.mintick) +
      ', "timeframe": "' + timeframe.period + '"}'

alert(buildJson(sigAction, sl_, tp_), alert.freq_once_per_bar_close)

// ── 시각화 ──────────────────────────────────────────────
plot(inHold and not na(aHi) ? aHi : na, "아시안 고점", color.aqua, 2, plot.style_linebr)
plot(inHold and not na(aLo) ? aLo : na, "아시안 저점", color.aqua, 2, plot.style_linebr)
plot(inHold and not na(nHi) ? nHi : na, "NY 고점", color.orange, 1, plot.style_linebr)
plot(inHold and not na(nLo) ? nLo : na, "NY 저점", color.orange, 1, plot.style_linebr)
plot(pdh, "전일 고점", color.new(color.purple, 40), 1, plot.style_circles)
plot(pdl, "전일 저점", color.new(color.purple, 40), 1, plot.style_circles)
plot(emaTrend, "EMA200", color.new(color.red, 40), 1)
bgcolor(inAsian ? color.new(color.yellow, 92) : inNyRange ? color.new(color.orange, 94) : na)
plotshape(longSignal,  "LONG",  shape.triangleup,   location.belowbar, color.green, size=size.small)
plotshape(shortSignal, "SHORT", shape.triangledown, location.abovebar, color.red,   size=size.small)
