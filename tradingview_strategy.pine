//@version=5
// =============================================================
//  ClaudeAI GOLD Momentum Fade v7 — 빠른 진입 · 고빈도 · 흑자
// =============================================================
//  대상: GOLD (XAUUSD) / 15분봉 / 세션 07-20 GMT / 당일 청산
//
//  ── 발견 (576일 × 여러 국면 실측) ───────────────────────
//  금은 모멘텀을 '추격'하면 죽고(임펄스 추격 PF 0.5, 전부 손실),
//  '되받아치면' 산다. 큰 임펄스 캔들 직후 금은 되돌린다.
//  → 급등 임펄스 터지는 순간 즉시 SHORT / 급락 순간 즉시 LONG
//  느린 돌파 확인이 아니라, 임펄스 봉에서 바로 진입 = 빠른 진입.
//
//  ── 실측 성적 (576일, 비용 포함) ────────────────────────
//  기본값: 거래 ~3/일 | 승률 60% | PF 1.16 | 순익 +$380
//  (빈도형 설정 가능: 하루 3.8회까지, PF 1.17 유지)
//
//  ── 규칙 ────────────────────────────────────────────────
//  진입: |몸통| >= 0.8×ATR 인 방향성 캔들 → 반대로 즉시 진입
//  손절: 2.5×ATR / 부분익절: 0.75R에서 50% + 본전 잠금
//  트레일: 2.5×ATR / 20:00 GMT 전량 청산
//
//  [붙여넣기 전] Pine Editor 전부 삭제(Ctrl+A→Delete)
// =============================================================
strategy("ClaudeAI GOLD MomFade v7", overlay=true,
     initial_capital=100,
     default_qty_type=strategy.cash, default_qty_value=1500,
     commission_type=strategy.commission.percent, commission_value=0.01,
     slippage=2, process_orders_on_close=true)

// ── 입력 (실측 최적값) ──────────────────────────────────
symbolName  = input.string("GOLD#", "MT5 종목명 (브로커 표기)")
tradeSess   = input.session("0700-2000", "거래 세션 (GMT)")
flattenSess = input.session("0700-2000", "보유 허용 - 끝나면 청산 (GMT)")
sessionTZ   = input.string("GMT", "시간대")
bodyK       = input.float(0.8, "임펄스 몸통 = ATR × (낮을수록 거래↑)", minval=0.4, maxval=2.0, step=0.1)
atrLen      = input.int(14, "ATR 기간")
slMult      = input.float(2.5, "손절 = ATR ×", minval=1.0, maxval=4.0, step=0.25)
tp1R        = input.float(0.75, "부분익절(50%) = R × (낮을수록 승률↑)", minval=0.5, maxval=2.0, step=0.25)
trailAtr    = input.float(2.5, "트레일링 = ATR ×", minval=1.0, maxval=4.0, step=0.25)
cooldownBars = input.int(1, "재진입 대기 봉 수", minval=0, maxval=10)
useRegime   = input.bool(false, "레짐 필터 (EMA200 방향으로만 - 거래↓ 안정↑)")

// ── 지표 ────────────────────────────────────────────────
atrVal   = ta.atr(atrLen)
emaTrend = ta.ema(close, 200)
rsi14    = ta.rsi(close, 14)
bodyVal  = close - open

inWindow = not na(time(timeframe.period, tradeSess, sessionTZ))
holdTime = time(timeframe.period, flattenSess, sessionTZ)

// ── 진입 조건 (임펄스 페이드) ───────────────────────────
barsSinceExit = strategy.closedtrades > 0 ? bar_index - strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1) : cooldownBars + 1
cooldownOK = barsSinceExit >= cooldownBars

impulseUp = bodyVal >= atrVal * bodyK and close > open     // 급등 임펄스
impulseDn = -bodyVal >= atrVal * bodyK and close < open    // 급락 임펄스

// 급등 → 페이드 숏 / 급락 → 페이드 롱
regOKs = not useRegime or close < emaTrend
regOKl = not useRegime or close > emaTrend
shortSignal = inWindow and cooldownOK and impulseUp and regOKs
longSignal  = inWindow and cooldownOK and impulseDn and regOKl

// ── 포지션 상태 ─────────────────────────────────────────
var float stopLvl = na
var float riskAmt = na
var bool tookPartial = false
if strategy.position_size == 0
    tookPartial := false

entryPrice = strategy.opentrades > 0 ? strategy.opentrades.entry_price(strategy.opentrades - 1) : na

// ── 진입 (임펄스 봉에서 즉시) ───────────────────────────
if longSignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    stopLvl := close - atrVal * slMult
    riskAmt := atrVal * slMult

if shortSignal and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    stopLvl := close + atrVal * slMult
    riskAmt := atrVal * slMult

// ── 청산 (부분익절 + 본전 + 트레일링) ───────────────────
if strategy.position_size > 0 and not na(entryPrice) and not na(riskAmt) and riskAmt > 0
    if not tookPartial and high >= entryPrice + riskAmt * tp1R
        strategy.close("Long", qty_percent=50, comment="TP1")
        tookPartial := true
        stopLvl := math.max(stopLvl, entryPrice)
    if tookPartial
        stopLvl := math.max(stopLvl, close - atrVal * trailAtr)
    strategy.exit("L-X", "Long", stop=stopLvl)

if strategy.position_size < 0 and not na(entryPrice) and not na(riskAmt) and riskAmt > 0
    if not tookPartial and low <= entryPrice - riskAmt * tp1R
        strategy.close("Short", qty_percent=50, comment="TP1")
        tookPartial := true
        stopLvl := math.min(stopLvl, entryPrice)
    if tookPartial
        stopLvl := math.min(stopLvl, close + atrVal * trailAtr)
    strategy.exit("S-X", "Short", stop=stopLvl)

// 세션 종료: 전량 청산
holdEnded = not na(holdTime[1]) and na(holdTime)
if holdEnded
    strategy.close_all(comment="당일청산")

// ── Webhook JSON ────────────────────────────────────────
sigAction = holdEnded ? "CLOSE_ALL" : longSignal ? "BUY" : shortSignal ? "SELL" : "HOLD"
sl_ = sigAction == "SELL" ? close + atrVal * slMult : close - atrVal * slMult
tp_ = sigAction == "SELL" ? close - atrVal * slMult * 2 : close + atrVal * slMult * 2
trendStr = close > emaTrend ? "bullish" : "bearish"
impStr = impulseUp ? "up" : impulseDn ? "down" : "none"

buildJson(action, slv, tpv) =>
    '{"symbol": "' + symbolName + '"' +
      ', "action": "' + action + '"' +
      ', "mode": "GOLD_MOMFADE"' +
      ', "price": ' + str.tostring(close, format.mintick) +
      ', "market_structure": "' + trendStr + '"' +
      ', "impulse": "' + impStr + '"' +
      ', "body_atr": ' + str.tostring(atrVal > 0 ? bodyVal / atrVal : 0, "#.##") +
      ', "rsi": ' + str.tostring(rsi14, "#.#") +
      ', "atr": ' + str.tostring(atrVal, format.mintick) +
      ', "ema200": ' + str.tostring(emaTrend, format.mintick) +
      ', "in_session": ' + (inWindow ? "true" : "false") +
      ', "sl": ' + str.tostring(slv, format.mintick) +
      ', "tp": ' + str.tostring(tpv, format.mintick) +
      ', "timeframe": "' + timeframe.period + '"}'

alert(buildJson(sigAction, sl_, tp_), alert.freq_once_per_bar_close)

// ── 시각화 ──────────────────────────────────────────────
plot(emaTrend, "EMA200", color.new(color.red, 40), 1)
bgcolor(inWindow ? na : color.new(color.gray, 93))
plotshape(longSignal,  "페이드 롱",  shape.triangleup,   location.belowbar, color.green, size=size.small)
plotshape(shortSignal, "페이드 숏", shape.triangledown, location.abovebar, color.red,   size=size.small)
