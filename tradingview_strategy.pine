//@version=5
// =============================================================
//  ClaudeAI Smart Money STRATEGY (백테스트 + 실거래 웹훅 겸용)
// =============================================================
//  구성: Market Structure + Volume Profile(POC) + Liquidity Sweep + CVD + VWAP
//
//  이 스크립트 하나로:
//   1) TradingView 하단 Strategy Tester에서 백테스트 (승률/수익/낙폭)
//   2) 실거래 시 webhook으로 MT5에 신호 전송
//
//  [백테스트 보는 법]
//   - 차트에 추가하면 하단에 "Strategy Tester" 탭이 자동으로 생김
//   - Overview / Performance / List of Trades 에서 결과 확인
//
//  [실거래 알람 만드는 법]
//   - 우측 알람(시계) → + 생성 → Condition: "ClaudeAI Smart Money Strategy"
//     → "Any alert() function call" 선택 → Webhook URL 입력
//
//  [붙여넣기 전] Pine Editor 내용 전부 삭제(Ctrl+A → Delete) 후 붙여넣기
// =============================================================
strategy("ClaudeAI Smart Money Strategy", overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0.0,
     slippage=2)

// ── 입력 파라미터 ──────────────────────────────────────
symbolName  = input.string("GOLD#", "MT5 종목명")
swingLen    = input.int(10, "Market Structure 스윙 길이")
pocLookback = input.int(50, "Volume Profile 탐색 구간")
sweepLen    = input.int(20, "Liquidity Sweep 탐색 구간")
atrLen      = input.int(14, "ATR 기간")
rrRatio     = input.float(2.0, "Risk:Reward 비율")
minScore    = input.int(4, "진입 최소 점수 (1~5, 낮을수록 거래 많음)", minval=1, maxval=5)
emaTrendLen = input.int(200, "추세 필터 EMA (방향)")
adxLen      = input.int(14, "ADX 기간 (추세 강도)")
adxMin      = input.float(20.0, "최소 ADX (이 값 이상일 때만 진입)")
useTrendFilter = input.bool(true, "추세 필터 사용 (EMA200 + ADX)")
cooldownBars = input.int(5, "재진입 대기 봉 수 (과매매 방지)")
useDateFilter = input.bool(false, "백테스트 기간 제한")
startDate   = input.time(timestamp("2024-01-01"), "시작일")

// ── 지표 계산 ──────────────────────────────────────────
// 거래량이 없는 심볼(일부 선물)에서도 작동하도록 안전 처리
vol = na(volume) or volume == 0 ? 1.0 : volume

// VWAP: 계산 불가(거래량 없음) 시 20기간 평균가로 대체
vwapRaw = ta.vwap(hlc3)
vwapVal = na(vwapRaw) ? ta.sma(hlc3, 20) : vwapRaw
atrVal  = ta.atr(atrLen)
rsiVal  = ta.rsi(close, 14)

// 추세 필터: EMA200 방향 + ADX 강도
emaTrend = ta.ema(close, emaTrendLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
trending = adxVal >= adxMin
upTrend   = close > emaTrend
downTrend = close < emaTrend

// Market Structure (BOS/CHoCH 근사)
swingHigh     = ta.highest(high, swingLen)
swingLow      = ta.lowest(low, swingLen)
prevSwingHigh = ta.highest(high, swingLen)[swingLen]
prevSwingLow  = ta.lowest(low, swingLen)[swingLen]
bullStructure = swingHigh > prevSwingHigh and swingLow > prevSwingLow
bearStructure = swingHigh < prevSwingHigh and swingLow < prevSwingLow
marketStructure = bullStructure ? "bullish" : bearStructure ? "bearish" : "ranging"

// Volume Profile POC (거래량 가중 평균가 근사, 거래량 없으면 단순평균)
pocNum = math.sum(hlc3 * vol, pocLookback)
pocDen = math.sum(vol, pocLookback)
poc    = pocDen > 0 ? pocNum / pocDen : close

// CVD (누적 델타 근사, 거래량 없으면 봉 방향 ±1로 모멘텀 측정)
delta  = close > open ? vol : close < open ? -vol : 0
cvdVal = math.sum(delta, 14)
cvdDir = cvdVal > 0 ? "rising" : cvdVal < 0 ? "falling" : "neutral"

// Liquidity Sweep (유동성 스윕)
recentLow  = ta.lowest(low, sweepLen)[1]
recentHigh = ta.highest(high, sweepLen)[1]
bullSweep  = low < recentLow and close > recentLow
bearSweep  = high > recentHigh and close < recentHigh
liqSweep   = bullSweep ? "bullish_sweep" : bearSweep ? "bearish_sweep" : "none"

// ── 진입 신호 조건 (점수제) ────────────────────────────
// 5개 조건 중 minScore개 이상 일치하면 진입. 우위 방향으로만.
inDateRange = not useDateFilter or time >= startDate

bullScore = (bullStructure ? 1 : 0) + (bullSweep ? 1 : 0) + (cvdDir == "rising" ? 1 : 0) + (close > vwapVal ? 1 : 0) + (rsiVal < 50 ? 1 : 0)
bearScore = (bearStructure ? 1 : 0) + (bearSweep ? 1 : 0) + (cvdDir == "falling" ? 1 : 0) + (close < vwapVal ? 1 : 0) + (rsiVal > 50 ? 1 : 0)

// 추세 필터 적용: 큰 추세 방향 + 추세가 강할 때만 진입
longOK  = not useTrendFilter or (upTrend and trending)
shortOK = not useTrendFilter or (downTrend and trending)

longSignal  = inDateRange and bullScore >= minScore and bullScore > bearScore and longOK
shortSignal = inDateRange and bearScore >= minScore and bearScore > bullScore and shortOK

longSL  = close - atrVal * 1.5
longTP  = close + atrVal * 1.5 * rrRatio
shortSL = close + atrVal * 1.5
shortTP = close - atrVal * 1.5 * rrRatio

// 재진입 대기: 마지막 거래 종료 후 일정 봉 이상 지나야 다시 진입 (과매매 방지)
barsSinceClose = strategy.closedtrades > 0 ? bar_index - strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1) : cooldownBars + 1
cooldownOK = barsSinceClose >= cooldownBars

// ── 백테스트 매매 (Strategy Tester용) ──────────────────
if longSignal and strategy.position_size <= 0 and cooldownOK
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=longSL, limit=longTP)

if shortSignal and strategy.position_size >= 0 and cooldownOK
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=shortSL, limit=shortTP)

// ── Webhook JSON 메시지 (실거래용) ─────────────────────
sigAction = longSignal ? "BUY" : shortSignal ? "SELL" : "HOLD"
sl_ = sigAction == "SELL" ? shortSL : longSL
tp_ = sigAction == "SELL" ? shortTP : longTP

buildJson(action, slv, tpv) =>
    '{"symbol": "' + symbolName + '"' +
      ', "action": "' + action + '"' +
      ', "price": ' + str.tostring(close, "#.##") +
      ', "market_structure": "' + marketStructure + '"' +
      ', "poc": ' + str.tostring(poc, "#.##") +
      ', "liquidity_sweep": "' + liqSweep + '"' +
      ', "cvd": "' + cvdDir + '"' +
      ', "vwap": ' + str.tostring(vwapVal, "#.##") +
      ', "rsi": ' + str.tostring(rsiVal, "#.#") +
      ', "atr": ' + str.tostring(atrVal, "#.##") +
      ', "sl": ' + str.tostring(slv, "#.##") +
      ', "tp": ' + str.tostring(tpv, "#.##") +
      ', "timeframe": "' + timeframe.period + '"}'

// 매 봉 마감마다 1회 전송 (서버가 포지션 유무로 진입/주시 자동 분기)
alert(buildJson(sigAction, sl_, tp_), alert.freq_once_per_bar_close)

// ── 차트 시각화 ─────────────────────────────────────────
plot(vwapVal, "VWAP", color.orange, 2)
plot(poc, "POC", color.purple, 1, plot.style_circles)
plot(emaTrend, "EMA200 추세", color.blue, 2)
bgcolor(trending ? na : color.new(color.gray, 90))  // 회색 배경 = 추세 약함(거래 안 함)
