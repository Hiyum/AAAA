//@version=5
// =============================================================
//  ClaudeAI Day Trading Strategy (외환 데이트레이딩, 당일 청산)
// =============================================================
//  대상: 외환 (EURUSD 등) / 권장 시간프레임: 15분
//
//  전략 컨셉 (데이트레이딩):
//   1. 추세 방향  : EMA50 / EMA200 정배열로 큰 방향 결정
//   2. 추세 강도  : ADX >= 기준 (추세장에서만 진입, 횡보 회피)
//   3. 눌림목 진입: 추세 방향으로 RSI 되돌림 후 재개될 때 진입
//   4. 세션 필터  : 런던+뉴욕 세션(유동성 높은 시간)에만 거래
//   5. 당일 청산  : 세션 종료 시 모든 포지션 자동 청산 (오버나이트 금지)
//
//  이 스크립트 하나로 백테스트 + 실거래 webhook 신호 전송.
//  [붙여넣기 전] Pine Editor 내용 전부 삭제(Ctrl+A → Delete) 후 붙여넣기
// =============================================================
strategy("ClaudeAI Day Trading Strategy", overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0.0,
     slippage=1)

// ── 입력 파라미터 ──────────────────────────────────────
symbolName  = input.string("AUDUSD", "MT5 종목명 (브로커 기준, 예: AUDUSD 또는 AUDUSD#)")
emaFastLen  = input.int(50,  "추세 EMA (빠름)")
emaSlowLen  = input.int(200, "추세 EMA (느림)")
adxLen      = input.int(14,  "ADX 기간")
adxMin      = input.float(20.0, "최소 ADX (추세 강도)")
rsiLen      = input.int(14,  "RSI 기간")
rsiPullbackLong  = input.float(45.0, "매수 눌림목 RSI 기준 (이하로 눌렸다 회복)")
rsiPullbackShort = input.float(55.0, "매도 되돌림 RSI 기준 (이상으로 올랐다 하락)")
atrLen      = input.int(14,  "ATR 기간")
slMult      = input.float(1.5, "손절 = ATR ×")
rrRatio     = input.float(1.8, "Risk:Reward 비율")
tradeSession = input.session("0700-2000", "거래 세션 (UTC, 런던+뉴욕)")
sessionTZ    = input.string("GMT", "세션 시간대")

// ── 지표 계산 ──────────────────────────────────────────
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

// 추세 방향 (정배열/역배열)
upTrend   = emaFast > emaSlow and close > emaFast
downTrend = emaFast < emaSlow and close < emaFast
trending  = adxVal >= adxMin

// 세션 판단
inSession = not na(time(timeframe.period, tradeSession, sessionTZ))

// ── 눌림목 진입 신호 ────────────────────────────────────
// 매수: 상승추세 + RSI가 기준 아래로 눌렸다가(직전) 다시 위로 회복(현재)
pulledBackLong  = rsiVal[1] < rsiPullbackLong and rsiVal > rsiPullbackLong
pulledBackShort = rsiVal[1] > rsiPullbackShort and rsiVal < rsiPullbackShort

longSignal  = inSession and trending and upTrend  and pulledBackLong
shortSignal = inSession and trending and downTrend and pulledBackShort

longSL  = close - atrVal * slMult
longTP  = close + atrVal * slMult * rrRatio
shortSL = close + atrVal * slMult
shortTP = close - atrVal * slMult * rrRatio

// ── 백테스트 매매 (Strategy Tester용) ──────────────────
if longSignal and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=longSL, limit=longTP)

if shortSignal and strategy.position_size >= 0
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=shortSL, limit=shortTP)

// ── 당일 청산 (세션 종료 시 전체 청산) ─────────────────
sessionEnded = inSession[1] and not inSession
if sessionEnded
    strategy.close_all(comment="당일청산")

// ── Webhook JSON 메시지 (실거래용) ─────────────────────
// 세션 종료 봉에서는 action=CLOSE_ALL 전송 → 서버가 전 포지션 청산
sigAction = sessionEnded ? "CLOSE_ALL" : longSignal ? "BUY" : shortSignal ? "SELL" : "HOLD"
sl_ = sigAction == "SELL" ? shortSL : longSL
tp_ = sigAction == "SELL" ? shortTP : longTP
trendStr = upTrend ? "bullish" : downTrend ? "bearish" : "ranging"

buildJson(action, slv, tpv) =>
    '{"symbol": "' + symbolName + '"' +
      ', "action": "' + action + '"' +
      ', "price": ' + str.tostring(close, "#.#####") +
      ', "market_structure": "' + trendStr + '"' +
      ', "adx": ' + str.tostring(adxVal, "#.#") +
      ', "rsi": ' + str.tostring(rsiVal, "#.#") +
      ', "ema_fast": ' + str.tostring(emaFast, "#.#####") +
      ', "ema_slow": ' + str.tostring(emaSlow, "#.#####") +
      ', "atr": ' + str.tostring(atrVal, "#.#####") +
      ', "in_session": ' + (inSession ? "true" : "false") +
      ', "sl": ' + str.tostring(slv, "#.#####") +
      ', "tp": ' + str.tostring(tpv, "#.#####") +
      ', "timeframe": "' + timeframe.period + '"}'

// 매 봉 마감마다 1회 전송 (진입/주시/당일청산 모두 서버가 처리)
alert(buildJson(sigAction, sl_, tp_), alert.freq_once_per_bar_close)

// ── 차트 시각화 ─────────────────────────────────────────
plot(emaFast, "EMA50", color.blue, 2)
plot(emaSlow, "EMA200", color.red, 2)
bgcolor(inSession ? na : color.new(color.gray, 92))  // 회색 = 세션 밖(거래 안 함)
plotshape(longSignal,  "LONG",  shape.triangleup,   location.belowbar, color.green, size=size.small)
plotshape(shortSignal, "SHORT", shape.triangledown, location.abovebar, color.red,   size=size.small)
